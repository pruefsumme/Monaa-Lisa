# The site blocks for the server's Caddy (deploy/compose.server.yaml).
# The API lives on the same domain under /api, so the browser needs no CORS.
# FRONTEND_ORIGIN and PUBLIC_API_BASE_URL in .env must name the same domain.

monaalisa.org {
	encode zstd gzip
	# The API sets its own (helmet), these cover the pages of the frontend.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle_path /api/* {
		reverse_proxy monaa-backend:3000
	}

	handle {
		reverse_proxy monaa-frontend:3000
	}
}

# Older and alternative names lead to the one above, links into the map
# (paths and ?category=... queries) keep working.
www.monaalisa.org, monaa.pruefsumme.xyz {
	redir https://monaalisa.org{uri} permanent
}
